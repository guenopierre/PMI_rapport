      \field{labeltitlesource}{title}
      \field{abstract}{The historical (1972–2013) gaps of the solar wind parameters are ﬁlled-in by smooth modes of covariability using the continuous geomagnetic indices with Singular Spectrum Analysis (SSA). A systematic study using experiments with synthetic gaps has been performed to determine optimal SSA parameters for reconstruction of gaps over full solar cycle and to assess the reconstruction skill. We assessed the accuracy of the SSA gap-ﬁlling for solar wind reconstruction in T96 and TS05 empirical magnetic ﬁeld models by using GOES measurements at geostationary orbit, and compared it to the results based on parameters from existing Qin and Denton interpolation. The SSA gap-ﬁlling method does improve accuracy of empirical magnetic ﬁeld models, especially when gaps are large and in particular for the TS05 magnetic ﬁeld model.}
      \field{issn}{0094-8276, 1944-8007}
      \field{journaltitle}{Geophysical Research Letters}
